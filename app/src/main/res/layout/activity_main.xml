<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OvercomeVPN"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/tvProtocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Протокол: —"
            android:textSize="12sp"
            android:textColor="@color/blue_light"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="24dp"
        android:background="@color/bg_card">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Отключено"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:gravity="center"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VPN Ключ"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="8dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/bg_input"
            android:padding="14dp"
            android:paddingEnd="52dp"
            android:textColor="@color/white"
            android:textColorHint="@color/hint"
            android:textSize="12sp"
            android:gravity="top"
            android:hint="Вставьте ключ: vless://... vmess://... ss://..."
            android:inputType="textMultiLine"/>

        <ImageButton
            android:id="@+id/btnPaste"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|top"
            android:layout_margin="6dp"
            android:background="@color/bg_card"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Вставить"/>
    </FrameLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ПОДКЛЮЧИТЬ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/blue"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OvercomeVPN • VLESS • VMess • Shadowsocks • Trojan"
        android:textColor="@color/hint"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

</LinearLayout>
